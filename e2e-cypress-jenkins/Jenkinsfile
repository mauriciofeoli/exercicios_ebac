pipeline {
    agent any

    stages {
        stage('Clonar o repositorio') {
            steps {
                git branch: 'main', url: 'https://github.com/mauriciofeoli/exercicios_ebac.git'
            }
        }
        stage('Instalar dependencias') {
            steps {
                dir('e2e-cypress-jenkins') {
                    bat 'npm install'
                }
            }
        }
        stage('Executar Testes') {
            steps {
                dir('e2e-cypress-jenkins') {
                    bat 'set NO_COLOR=1 && npm run cy:run'
                }
            }
        }
    }
}
